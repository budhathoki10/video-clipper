# Copy to backend/.env and fill in the key for the AI engine you use.
# backend/.env is gitignored. Keys can also be replaced from Settings in the app.
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Google Desktop OAuth client used only for YouTube channel connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Separate Google Web application OAuth client used only for app login.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
