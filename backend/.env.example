# Copy to backend/.env and fill in the values. backend/.env is gitignored. On a host such as Render,
# set the same names in the host's environment instead.

# The database (MongoDB Atlas or any MongoDB). Accounts, jobs, clips, posts and settings live here.
# Use the connection string from Atlas with the real password filled in.
MONGODB_URI=
# Optional: the database name (default: clipper).
MONGODB_DB=

# Encrypts each person's saved API keys and YouTube token. Any long random text. Keep it: if it
# changes, saved keys can no longer be read. Optional on one computer (one is made for you).
APP_SECRET_KEY=

# Google "Web application" OAuth client. Used for sign-in and for connecting each person's YouTube channel.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# The NVIDIA key every person uses by default. People add their own keys for other providers.
NVIDIA_API_KEY=

# Where downloaded videos and finished clips are kept (S3-compatible storage).
BLOMP_ACCESS_KEY_ID=
BLOMP_SECRET_ACCESS_KEY=
BLOMP_BUCKET=

# Which jobs this computer's worker takes when several computers share one database:
#   all   (default) everything, for one computer
#   links only jobs made from a pasted YouTube link, for a home PC that YouTube does not block
#   files everything else, for a hosting server that YouTube blocks
CLIPPER_WORKER_ACCEPTS=

# Hosting only: the address people open, for example https://clips.yourdomain.com (no trailing
# slash). Leave empty on your own computer, and on Render until you use a custom domain.
PUBLIC_URL=
