# Copy to backend/.env and fill in the key for the AI engine you use.
# backend/.env is gitignored. Keys can also be replaced from Settings in the app.
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Google Desktop OAuth client used only for YouTube channel connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Separate Google Web application OAuth client used only for app login.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# Hosting. PUBLIC_URL is the address people open (no trailing slash). Anyone with a Google account
# can sign in and make clips; each person sees only their own work.
PUBLIC_URL=
# The owner(s), comma separated. Owners can change keys, the AI engine and the YouTube channel and
# can post to it. Set this on a hosted app: if it is empty, the first account to sign in is the owner.
ADMIN_EMAILS=
# Optional: only these emails may sign in. Leave empty to let anyone in.
ALLOWED_EMAILS=
